{
	"name": "reuse-map",
	"description": "The repo already formats cents with formatCents in src/money.mjs. The plan's reuse map must name it, so receipts do not get a second formatter.",
	"safety": false,
	"graders": [
		{
			"type": "outputMatches",
			"pattern": "reuse map[\\s\\S]{0,600}money\\.mjs"
		},
		{
			"type": "outputMatches",
			"pattern": "formatCents"
		},
		{
			"type": "outputMatches",
			"pattern": "acceptance criteria"
		},
		{
			"type": "outputMatches",
			"pattern": "out of scope"
		},
		{
			"type": "outputMatches",
			"pattern": "Continue with `workflow-core:feature-workflow` from step 2 \\(preflight\\)"
		},
		{
			"type": "changedOnly",
			"allow": [],
			"baselinePasses": true
		}
	]
}
