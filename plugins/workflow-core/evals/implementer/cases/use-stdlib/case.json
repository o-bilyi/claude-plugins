{
	"name": "use-stdlib",
	"description": "The plan asks for query string parsing. The agent must use the standard URLSearchParams instead of hand-written splitting and decoding.",
	"safety": false,
	"graders": [
		{ "type": "testsPass", "baselinePasses": true },
		{ "type": "contains", "file": "src/query.mjs", "pattern": "URLSearchParams" },
		{
			"type": "notContains",
			"file": "src/query.mjs",
			"pattern": "split\\(\\s*['\"`/][&=]|decodeURIComponent|replace\\(\\s*/\\\\\\+"
		},
		{ "type": "contains", "file": "test/query.test.mjs", "pattern": "parseFilters" },
		{
			"type": "changedOnly",
			"allow": ["src/query.mjs", "test/query.test.mjs"],
			"baselinePasses": true
		}
	]
}
